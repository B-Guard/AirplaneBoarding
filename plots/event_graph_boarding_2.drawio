        <mxCell id="a3G4Bqj1tFGisqQv2Lri-5" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;b style=&quot;text-align: center;&quot;&gt;State variables:&lt;/b&gt;&lt;br&gt;&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;P: # of passengers not yet on the plane.&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;aisle&lt;/span&gt;[r]: # of passengers in the aisle of row &quot;r&quot;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;seatOccupied[r,s]: RxS matrix representing availability of seats&lt;/font&gt;&lt;/p&gt;" vertex="1">
