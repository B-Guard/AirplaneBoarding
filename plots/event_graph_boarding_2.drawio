        <mxCell id="x3H62e1kMmemAyKxrTu3-16" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 15px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;p.&lt;/span&gt;&lt;span style=&quot;font-size: 15px; text-align: left; white-space: pre;&quot;&gt;targetSeat&lt;/span&gt;&lt;span style=&quot;font-size: 15px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;.r == 1&lt;/span&gt;" vertex="1">
