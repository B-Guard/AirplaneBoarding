        </mxCell>
        <mxCell id="x3H62e1kMmemAyKxrTu3-18" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;b style=&quot;text-align: center;&quot;&gt;Notations:&lt;/b&gt;&lt;br&gt;&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;p: passenger involved in event&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;r: row involved in event&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;s: seat involved in event&lt;/span&gt;&lt;/p&gt;" vertex="1">
