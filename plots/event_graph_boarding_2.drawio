        </mxCell>
        <mxCell id="x3H62e1kMmemAyKxrTu3-20" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;t_seat =&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-size: 15px; text-align: left;&quot;&gt;sitting_down(p)&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="190" x="1198.13" y="250" as="geometry" />
        </mxCell>
        <mxCell id="x3H62e1kMmemAyKxrTu3-21" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 15px; text-align: left;&quot;&gt;aisle&lt;/span&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;[r]--&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;seatOccupied[r,s] = True&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="176.25" x="1340" y="340" as="geometry" />
        </mxCell>
        <mxCell id="x3H62e1kMmemAyKxrTu3-27" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;b style=&quot;text-align: center;&quot;&gt;Functions:&lt;/b&gt;&lt;br&gt;&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;sitting_down(p, r, s){&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Map seatOccupied[r,:] to first column in occupancy map&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Return time corresponding to p.targetSeat in [A, B, C]&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;moving_time(p, r, t_walk){&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;t_to_reach_seat = (r-1)*(t_walk + t_delay)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Returns time it takes to reach&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 15px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;p.targetSeat&lt;/span&gt;&lt;span style=&quot;font-size: 15px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;including t_walk and&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; delay time&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;}&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="470" width="480" x="1096.5" y="500" as="geometry" />
        </mxCell>
